{
  "expo": {
    "name": "CheckFridge",
    "slug": "checkfridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.checkfridge.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.checkfridge.app"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1D9E75"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "checkfridge",
    "extra": {
      "eas": {
        "projectId": "0b6a823a-9894-461b-8a76-8eef856247e1"
      }
    },
    "owner": "annabananasky",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0b6a823a-9894-461b-8a76-8eef856247e1"
    }
  }
}
